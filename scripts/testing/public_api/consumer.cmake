cmake_minimum_required(VERSION 3.28)
project(public_package_consumer LANGUAGES CXX)
cmake_file_api(QUERY API_VERSION 1 CODEMODEL 2)

# Explicitly search the installed target prefix when a cross toolchain restricts package roots.
list(APPEND CMAKE_FIND_ROOT_PATH "${CMAKE_PREFIX_PATH}")
find_package(${WIOLA_PUBLIC_PACKAGE} CONFIG REQUIRED)

add_executable(public_consumer consumer.cpp)
target_link_libraries(public_consumer PRIVATE ${WIOLA_PUBLIC_TARGET})
file(STRINGS headers.txt public_headers)
set(header_sources)
foreach(header IN LISTS public_headers)
    list(LENGTH header_sources index)
    set(source "${CMAKE_CURRENT_BINARY_DIR}/header-${index}.cpp")
    file(WRITE "${source}" "#include <${header}>\n")
    list(APPEND header_sources "${source}")
endforeach()
add_library(public_headers OBJECT ${header_sources})
target_link_libraries(public_headers PRIVATE ${WIOLA_PUBLIC_TARGET})

file(STRINGS private.txt private_headers)
set(index 0)
foreach(header IN LISTS private_headers)
    set(source "${CMAKE_CURRENT_BINARY_DIR}/private-${index}.cpp")
    file(WRITE "${source}" "#include <${header}>\nint main() {}\n")
    add_executable(private_${index} EXCLUDE_FROM_ALL "${source}")
    target_link_libraries(private_${index} PRIVATE ${WIOLA_PUBLIC_TARGET})
    math(EXPR index "${index} + 1")
endforeach()
