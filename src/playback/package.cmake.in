@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(wiola_media CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/wiola_playback-targets.cmake")
set(wiola_playback_api_FOUND TRUE)
set(wiola_playback_runtime_FOUND FALSE)
# A values-only installation does not need the audio/worker runtime closure.
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/wiola_playback-runtime-targets.cmake")
    find_dependency(wiola_audio CONFIG COMPONENTS output)
    find_dependency(Threads)
    include("${CMAKE_CURRENT_LIST_DIR}/wiola_playback-runtime-targets.cmake")
    set(wiola_playback_runtime_FOUND TRUE)
endif()
check_required_components(wiola_playback)
