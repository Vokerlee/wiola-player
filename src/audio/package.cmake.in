@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(wiola_borrowed_reference CONFIG)
find_dependency(wiola_media CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/wiola_audio-targets.cmake")
set(wiola_audio_output_FOUND TRUE)
include("${CMAKE_CURRENT_LIST_DIR}/wiola_audio-dsp-targets.cmake" OPTIONAL)
set(wiola_audio_dsp_FOUND FALSE)
if(TARGET wiola::audio_dsp)
    set(wiola_audio_dsp_FOUND TRUE)
endif()
check_required_components(wiola_audio)
