cmake_minimum_required(VERSION 3.28)
project(installed_consumer LANGUAGES CXX)
enable_testing()

# Cross toolchains may restrict package searches to their configured roots.
list(APPEND CMAKE_FIND_ROOT_PATH "${CMAKE_PREFIX_PATH}")
find_package(@arg_PACKAGE@ CONFIG REQUIRED)

add_executable(public_consumer consumer.cpp)
target_link_libraries(public_consumer PRIVATE @arg_TARGET@)
add_test(NAME PublicConsumer.Runs COMMAND public_consumer)

# Compile the actual installed headers independently, without another header registry.
get_target_property(include_roots @arg_TARGET@ INTERFACE_INCLUDE_DIRECTORIES)
set(header_sources)
foreach(root IN LISTS include_roots)
    file(GLOB_RECURSE headers RELATIVE "${root}" "${root}/*.hpp" "${root}/*.h")
    foreach(header IN LISTS headers)
        list(LENGTH header_sources index)
        set(probe "${CMAKE_CURRENT_BINARY_DIR}/header-${index}.cpp")
        file(WRITE "${probe}" "#include <${header}>\n")
        list(APPEND header_sources "${probe}")
    endforeach()
endforeach()
if(NOT header_sources)
    message(FATAL_ERROR "The installed package exposes no headers")
endif()
add_library(public_headers OBJECT ${header_sources})
target_link_libraries(public_headers PRIVATE @arg_TARGET@)
