cmake_minimum_required(VERSION 3.28)

# This file is configured into the build directory for one installed-package test.
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(work "@CMAKE_CURRENT_BINARY_DIR@/Testing/PublicPackage-${run_id}")
file(MAKE_DIRECTORY "${work}")

function(package_step name)
    execute_process(
        COMMAND ${ARGN}
        WORKING_DIRECTORY "${work}"
        RESULT_VARIABLE result
        OUTPUT_VARIABLE output
        ERROR_VARIABLE errors
        TIMEOUT 180
    )
    file(WRITE "${work}/${name}.log" "${output}${errors}")
    if(NOT result STREQUAL "0")
        message(
            FATAL_ERROR
            "${name} failed (${result}). Logs: ${work}\n${output}${errors}"
        )
    endif()
endfunction()

foreach(component IN ITEMS @arg_COMPONENTS@)
    package_step(
        "install-${component}"
        "@CMAKE_COMMAND@"
        --install
        "@CMAKE_BINARY_DIR@"
        --component
        "${component}"
        --prefix
        "${work}/initial prefix"
    )
endforeach()
file(RENAME "${work}/initial prefix" "${work}/relocated prefix")
file(MAKE_DIRECTORY "${work}/source")
file(COPY_FILE "@arg_CONSUMER@" "${work}/source/consumer.cpp")
file(COPY_FILE "@consumer_fixture@" "${work}/source/CMakeLists.txt")
set(toolchain_arguments)
if(NOT "@consumer_toolchain@" STREQUAL "")
    list(
        APPEND toolchain_arguments
        "-DCMAKE_TOOLCHAIN_FILE=@consumer_toolchain@"
    )
endif()
package_step(
    configure
    "@CMAKE_COMMAND@"
    -S
    "${work}/source"
    -B
    "${work}/build"
    "-DCMAKE_CXX_COMPILER=@CMAKE_CXX_COMPILER@"
    "-DCMAKE_SYSTEM_NAME=@CMAKE_SYSTEM_NAME@"
    "-DCMAKE_PREFIX_PATH=${work}/relocated prefix"
    ${toolchain_arguments}
)
package_step(
    build
    "@CMAKE_COMMAND@"
    --build
    "${work}/build"
    --parallel
    2
)
if(NOT @CMAKE_CROSSCOMPILING@)
    package_step(
        run
        "@CMAKE_CTEST_COMMAND@"
        --test-dir
        "${work}/build"
        --output-on-failure
        --no-tests=error
    )
endif()
message(STATUS "Public package @arg_PACKAGE@ passed. Logs: ${work}")
